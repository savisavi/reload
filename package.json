{
  "name": "reload",
  "version": "1.0.0",
  "description": "RELOAD — procedural pixel-art cyberpunk dungeon with autonomous mercenaries",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
